# MANIFEST.in

# Include package metadata files
include README.md
include LICENSE
include pyproject.toml

# Include template files
recursive-include pyguidos/templates *

# Include example data
recursive-include pyguidos/data *

# Include notebooks (for source distribution, not installed with pip)
recursive-include notebooks *

# Include tests (for source distribution, not installed with pip)
recursive-include tests *

# Exclude runtime and cache artifacts
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * .DS_Store
recursive-exclude * *.egg-info